# مفتاح Claude لتوليد الأفكار والنصوص (بدونه يستخدم بنك أفكار جاهز)
ANTHROPIC_API_KEY=
# بديل: OmniRoute (من Dashboard ← Endpoints). إذا موجود يُستخدم قبل Claude
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
# مفتاح Pexels المجاني لفيديوهات الخلفية (بدونه خلفية متحركة ملونة)
PEXELS_API_KEY=
# بديل مجاني: مفتاح Pixabay (pixabay.com/api/docs)
PIXABAY_API_KEY=
# بيانات رفع يوتيوب (شغّل scripts/get_youtube_token.py للحصول عليها)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# إعدادات المحتوى
SHORTS_NICHE=حقائق مدهشة وغريبة عن العالم والعلم والتاريخ
SHORTS_LANGUAGE=ar
SHORTS_VOICE=ar-SA-HamedNeural
SHORTS_PRIVACY=public
